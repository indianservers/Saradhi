# Production environment
# Inject credentials from a secret manager; this file intentionally has no credentials.
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_RUNTIME_ROLE:REPLACE_WITH_SECRET@REPLACE_WITH_PRIVATE_HOST:5432/quickbuddy_production
DATABASE_SSL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=1
REDIS_URL=rediss://REPLACE_WITH_SECRET@REPLACE_WITH_PRIVATE_HOST:6379/0
METRICS_ENABLED=false
CORS_ORIGINS=["https://admin.example.invalid","https://city.example.invalid","https://support.example.invalid"]
OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=quickbuddy-production
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
AUTH_PRIVATE_KEY_PATH=
RAZORPAY_ENABLED=false
RAZORPAY_MODE=disabled
RAZORPAY_LIVE_APPROVAL=false
